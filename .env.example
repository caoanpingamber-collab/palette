# Copy to .env.local only when overriding defaults. Never put passwords in VITE_*.
HISTORY_PORT=5192
HISTORY_DATA_DIR=.history-data
HISTORY_MAX_BYTES=1073741824
# Local website can stream to the verified deployed backend, without local archival.
# HISTORY_STORAGE=miaoda-remote
# HISTORY_REMOTE_URL=https://bytedance.feishu.link/app/your_approved_backend_app_id
# Public address only; never put passwords or tokens in VITE_*.
# VITE_HISTORY_ADMIN_URL=https://bytedance.feishu.link/app/your_approved_backend_app_id/admin
# HISTORY_MIAODA_APP_ID=your_approved_backend_app_id
# HISTORY_MIAODA_ENV=online
# Development connector; do not use CLI credentials for a production server.
# HISTORY_STORAGE=miaoda
# HISTORY_MIAODA_APP_ID=your_approved_full_stack_app_id
# Pull private credentials into .history-data/miaoda-runtime/.env.local.
# Off by default. Turn on only after the selected provider passes verification.
HISTORY_ARCHIVE_ENABLED=false
# Production requires a durable disk/private storage, exact HTTPS origin and TLS.
# HISTORY_ALLOWED_ORIGINS=https://your-approved-domain.example
# HISTORY_HOST=127.0.0.1
